# BOLSABR staging — copy values into Coolify environment variables.
# Do not commit real secrets or private hostnames.

# Public HTTPS URL used by canonical, Open Graph, robots and sitemaps.
BOLSABR_SITE_URL=https://staging.example.com

# Internal service-to-service address. Keep FastAPI private.
BOLSABR_API_BASE_URL=http://api:8000

# Publisher defaults validated by live top-50 proof.
BOLSABR_UNIVERSE_MODE=auto
BOLSABR_UNIVERSE_KIND=stocks
BOLSABR_UNIVERSE_LIMIT=50
BOLSABR_UNIVERSE_MIN_FINANCIAL_VOLUME=0

# Only used if manual mode is selected.
BOLSABR_UNDERLYINGS=PETR4

# Optional local host binding when using docker compose outside Coolify.
BOLSABR_WEB_PORT=3000
